# Copy to supabase/functions/.env (git-ignored) for local Edge Function runs:
#   cp supabase/functions/.env.example supabase/functions/.env
GEMINI_API_KEY=your-google-ai-studio-key
# Optional: primary model (default gemini-3.5-flash-lite) and fallback used once on HTTP 429
# (default gemini-3.1-flash-lite; set empty to disable). Flash-Lite has the largest free-tier quota.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Server-side pepper for hashing caller IPs (any long random string)
IP_HASH_SALT=change-me-to-a-long-random-string
# Comma-separated extra allowed origins (portfolio site); localhost dev origins are built in
ALLOWED_ORIGINS=https://your-portfolio.example.com
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by the Edge runtime
