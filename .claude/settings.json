{
  "enabledPlugins": {
    "vercel@anthropic-plugin-directory": true,
    "expo@anthropic-plugin-directory": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "context7@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(docker run --rm -v * denoland/deno:latest *)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx expo lint:*)",
      "Bash(npx eslint:*)",
      "Bash(supabase functions deploy text-to-sql:*)",
      "Bash(supabase status:*)",
      "Bash(supabase functions list:*)",
      "Bash(curl -s http://127.0.0.1:54321/functions/v1/text-to-sql:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-check.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
